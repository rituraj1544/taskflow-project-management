generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

model User {
  id             Int             @id @default(autoincrement())
  fullName       String          @db.VarChar(120)
  email          String          @unique @db.VarChar(191)
  passwordHash   String          @db.VarChar(255)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskCreator")
  comments       Comment[]
  notifications  Notification[]
  activities     ActivityLog[]

  @@index([fullName])
}

model Project {
  id          Int             @id @default(autoincrement())
  demoKey     String?         @unique @db.VarChar(191)
  name        String          @db.VarChar(160)
  description String?         @db.Text
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus   @default(PLANNING)
  ownerId     Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  tasks       Task[]
  activities  ActivityLog[]
  notifications Notification[]

  @@index([ownerId, status])
  @@index([updatedAt])
}

model ProjectMember {
  id        Int         @id @default(autoincrement())
  projectId Int
  userId    Int
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, projectId])
}

model Task {
  id          Int          @id @default(autoincrement())
  demoKey     String?      @unique @db.VarChar(191)
  title       String       @db.VarChar(180)
  description String?      @db.Text
  projectId   Int
  assigneeId  Int?
  creatorId   Int
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  comments    Comment[]
  notifications Notification[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([createdAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  demoKey   String?  @unique @db.VarChar(191)
  body      String   @db.Text
  taskId    Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Notification {
  id        Int       @id @default(autoincrement())
  demoKey   String?   @unique @db.VarChar(191)
  userId    Int
  type      String    @db.VarChar(50)
  message   String    @db.VarChar(255)
  taskId    Int?
  projectId Int?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([taskId])
  @@index([projectId])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  demoKey   String?  @unique @db.VarChar(191)
  projectId Int
  userId    Int?
  action    String   @db.VarChar(80)
  detail    String   @db.VarChar(255)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}
